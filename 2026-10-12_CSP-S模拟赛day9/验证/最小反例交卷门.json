{
  "schema": 1,
  "purpose": "Regression from source-derived statements; not the OJ oracle",
  "tasks": [
    {
      "name": "zerofree",
      "source": "zerofree_final.cpp",
      "cases": [
        {
          "label": "n=1不能跳过",
          "input": "1 3\n3\n9\n",
          "expected": "9\n"
        },
        {
          "label": "样例1",
          "input": "3 3\n1 1 1\n5 1 5\n",
          "expected": "1\n"
        },
        {
          "label": "全倍数",
          "input": "11 3\n3 3 3 3 3 3 3 3 3 3 3\n7 7 7 7 7 7 7 7 7 7 7\n",
          "expected": "7\n"
        }
      ]
    },
    {
      "name": "count",
      "source": "count_final.cpp",
      "cases": [
        {
          "label": "单向不可达",
          "input": "2 1\n2 1 3\n",
          "expected": "-1\n"
        },
        {
          "label": "重边两条",
          "input": "2 2\n1 2 1\n1 2 1\n",
          "expected": "2\n"
        },
        {
          "label": "二关键字先比距离",
          "input": "4 5\n1 2 1\n2 4 2\n1 3 2\n3 4 1\n1 4 4\n",
          "expected": "2\n"
        }
      ]
    },
    {
      "name": "color",
      "source": "color_final.cpp",
      "cases": [
        {
          "label": "最后一瓶唯一解",
          "input": "1\n2 1 1\n5\n1\n5\n",
          "expected": "Yes\n"
        },
        {
          "label": "官方示例两问",
          "input": "2\n4 3 2\n5 11 7\n6 14 9\n1 1 1\n8 18 2\n1 1 10\n5 3 4\n2 2 2\n5 11 7\n6 14 9\n1 1 1\n8 18 2\n1 1 10\n",
          "expected": "Yes\nNo\n"
        }
      ]
    },
    {
      "name": "silent",
      "source": "silent_final.cpp",
      "cases": [
        {
          "label": "官方样例1",
          "input": "3 5 6\n1 2\n2 3 1\n2 4 1 3 5\n",
          "expected": "30\n"
        }
      ]
    }
  ]
}
